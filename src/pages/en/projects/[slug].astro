---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/Layout.astro';
import ProjectView from '~/components/pages/ProjectView.astro';
import { depthForProject } from '~/lib/depth';

export async function getStaticPaths() {
  const projects = await getCollection('projects', (e) => e.data.locale === 'en');
  return projects.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<Layout
  title={entry.data.title}
  description={entry.data.summary}
  depth={depthForProject(entry.data.slug)}
>
  <ProjectView entry={entry} />
</Layout>
