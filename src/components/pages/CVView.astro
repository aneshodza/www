---
import { getCollection } from 'astro:content';
import ExperienceItem from '~/components/ExperienceItem.astro';
import LanguageBar from '~/components/LanguageBar.astro';
import { render } from 'astro:content';
import { getLocaleFromUrl, useTranslations } from '~/i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const experience = (
  await getCollection('experience', (e) => e.data.locale === locale)
).sort((a, b) => a.data.order - b.data.order);

const education = (
  await getCollection('education', (e) => e.data.locale === locale)
).sort((a, b) => a.data.order - b.data.order);

const experienceRendered = await Promise.all(
  experience.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  }),
);

const educationRendered = await Promise.all(
  education.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  }),
);

const achievements =
  locale === 'de'
    ? [
        {
          title: 'Gewinner des Hack Winterthur 2026',
          detail:
            'Erster Platz beim ZHAW-Hackathon, erzielt mit LocalMate, einem agentischen KI-Assistenten auf MCP-Basis.',
          period: '2026',
          href: 'https://www.zhaw.ch/de/ueber-uns/aktuell/news/detailansicht-news/event-news/zugang-fuer-alle-ist-uns-ein-persoenliches-anliegen',
          external: true,
        },
        {
          title: 'EFZ mit Bestnote (5.5) und Abschluss im Rang',
          detail: 'Lehrabschluss als Informatiker mit Auszeichnung.',
          period: '2024',
          href: '/abschluss-im-rang.pdf',
          external: false,
        },
        {
          title: 'Berufsmeisterschaft Informatik: 3. regional, 8. national',
          detail: 'Schweizer Berufsmeisterschaften, während der Lehre als Informatiker.',
          period: '2024',
          href: '/regionalmeisterschaft.pdf',
          external: false,
        },
      ]
    : [
        {
          title: 'Winner of Hack Winterthur 2026',
          detail:
            'First place at the ZHAW hackathon with LocalMate, an MCP-based agentic AI assistant.',
          period: '2026',
          href: 'https://www.zhaw.ch/de/ueber-uns/aktuell/news/detailansicht-news/event-news/zugang-fuer-alle-ist-uns-ein-persoenliches-anliegen',
          external: true,
        },
        {
          title: 'EFZ completed with an outstanding grade (5.5) and honours',
          detail: 'Vocational diploma in computer science, graduated with distinction.',
          period: '2024',
          href: '/abschluss-im-rang.pdf',
          external: false,
        },
        {
          title: 'Swiss IT skills championship: 3rd regional, 8th national',
          detail: 'National vocational skills competition, contested during my IT apprenticeship.',
          period: '2024',
          href: '/regionalmeisterschaft.pdf',
          external: false,
        },
      ];

const research =
  locale === 'de'
    ? [
        {
          period: '2025',
          title: 'mini-retrieve: Suchmaschine in Rust',
          detail:
            'Eine Suchmaschine, die ich von Grund auf in Rust geschrieben habe, ohne die üblichen Bibliotheken: eigener Tokenizer und Stemmer, Stopwort-Filter, invertierter Index und BM25-Ranking, alles hinter einer interaktiven Shell zum Inspizieren des Index. Es war mein tiefster Einstieg in angewandte hardwarenahe und performante Programmierung, und die fertige Engine beantwortet eine Cranfield-Anfrage in rund 70 Mikrosekunden.',
          short:
            'Eine Suchmaschine, von Grund auf in Rust geschrieben, vom Tokenizer und Stemmer bis zum invertierten Index und BM25-Ranking. Mein tiefster Einstieg in angewandte hardwarenahe und performante Programmierung, bei rund 70 Mikrosekunden pro Cranfield-Anfrage.',
          href: 'https://github.com/aneshodza/mini-retrieve',
          external: true,
          print: true,
        },
        {
          period: '2026',
          title: 'LLMs für Text-to-SQL evaluiert',
          detail:
            'Eine Kursarbeit über das Übersetzen natürlicher Sprache in SQL. Mit StatBot.Swiss, einem Benchmark auf echten Schweizer Bundesstatistiken, habe ich auf LangChain und LangGraph drei Systeme gebaut und verglichen: eine fixe Grounding-Pipeline, einen ReAct-Agenten, der die Datenbank nach den richtigen Werten abfragt, bevor er eine Query schreibt, und eine Kombination der beiden. Das Interessante ist das Grounding, also die exakten kategorischen Werte, das richtige Jahr und die richtige räumliche Ebene zu treffen, nicht die SQL-Syntax selbst.',
          short:
            'Eine Kursarbeit, die drei Wege vergleicht, natürliche Sprache in SQL über echte Bundesstatistiken zu übersetzen: eine fixe Grounding-Pipeline, einen ReAct-Agenten, der die Datenbank abfragt, und eine Kombination, gebaut auf LangChain und LangGraph.',
          href: 'https://drive.google.com/file/d/1sFv4ktlgIOtf23QgjB73a9o1WpDCtxHl/view',
          external: true,
          print: true,
        },
        {
          period: '2026',
          title: 'MNIST-Ziffernerkennung von Hand',
          detail:
            "Ein neuronales Netz für handgeschriebene Ziffern, von Hand in TypeScript geschrieben, ganz ohne Machine-Learning-Framework. Forward-Pass und Backpropagation habe ich selbst implementiert, ein mehrschichtiges Perzeptron mit ReLU-Schichten und einem Softmax über die zehn Ziffern. Trainiert auf 50'000 Bildern und getestet auf 9'000, erreicht es rund 95% Genauigkeit. Dazu gibt es eine kleine Web-Version, in der man eine Ziffer auf ein Canvas zeichnet, die vor der Erkennung an ihrem Schwerpunkt zentriert wird.",
          short:
            "Ein neuronales Netz für handgeschriebene Ziffern, von Hand in TypeScript geschrieben, ohne Machine-Learning-Framework. Forward-Pass und Backpropagation selbst implementiert; auf 50'000 Bildern trainiert, erreicht es rund 95% Genauigkeit auf MNIST.",
          href: 'https://digits.aneshodza.ch',
          external: true,
          print: false,
        },
        {
          period: '2025',
          title: 'Query-Fehler & kognitive Varianz',
          detail:
            'Eine kurze Arbeit darüber, wie Eingabefehler die Suche stören und wie günstig sich das beheben lässt. Ich habe drei medizinisch fundierte Fehlertypen simuliert, die Tippfehler einer gesunden Person, die zittrigen Fehler bei Parkinson und die Verwechslungen bei Dyslexie, und die BM25-Suche mit und ohne eine Korrektur gemessen, die jedes Wort über die Levenshtein-Distanz auf den nächsten Treffer abbildet.',
          short:
            'Eine kurze Arbeit darüber, wie Tippfehler, Parkinson und Dyslexie die BM25-Suche verschlechtern und wie eine Levenshtein-Korrektur sie wiederherstellt.',
          href: 'https://drive.google.com/file/d/1Azp9R1ufht2OSDB7ahYeeu1ro6APo-dL/view',
          external: true,
          print: true,
        },
        {
          period: '2025',
          title: 'Numerische Verfahren (HM2)',
          detail:
            'Eine Sammlung von rund zwanzig numerischen Verfahren, die ich in Python implementiert habe, während ich für Höhere Mathematik 2 an der ZHAW lernte, gehalten als kleine lauffähige Skripte statt als Notizen. Sie deckt einen guten Teil des Kurses ab: das Newton-Verfahren mit seinen gedämpften und vereinfachten Varianten, kubische Splines, Lagrange-Interpolation und Ausgleichsrechnung, Romberg-Integration, Runge-Kutta und Adams-Bashforth für Differentialgleichungen sowie ein paar angewandte Aufgaben wie ein Pendel und eine Raketenbahn. Das Modul gehört zu den anspruchsvolleren an der Schule, und die Verfahren so auszuschreiben ist, was mir darin eine 6.0 gebracht hat.',
          short:
            'Rund zwanzig numerische Verfahren von Grund auf in Python (Splines, Runge-Kutta, Romberg und mehr), für eine perfekte 6.0 in einem ZHAW-Mathematikmodul.',
          href: 'https://github.com/aneshodza/hm2-scripts',
          external: true,
          print: true,
        },
      ]
    : [
        {
          period: '2025',
          title: 'mini-retrieve: a search engine in Rust',
          detail:
            "A search engine I wrote from scratch in Rust, with none of the usual libraries doing the work: my own tokeniser and stemmer, stop-word filtering, an inverted index and BM25 ranking, all behind an interactive shell for inspecting the index. It was my deepest dive into applied low-level and high-performance programming, and the finished engine answers a Cranfield query in roughly 70 microseconds.",
          short:
            'A search engine written from scratch in Rust, from tokeniser and stemmer to an inverted index and BM25 ranking. My deepest dive into applied low-level and high-performance programming, at roughly 70 microseconds per Cranfield query.',
          href: 'https://github.com/aneshodza/mini-retrieve',
          external: true,
          print: true,
        },
        {
          period: '2026',
          title: 'Evaluating LLMs on Text-to-SQL',
          detail:
            "A course paper on translating plain-language questions into SQL. Using StatBot.Swiss, a benchmark built on real Swiss federal statistics, I built and compared three systems on LangChain and LangGraph: a fixed grounding pipeline, a ReAct agent that probes the database for the right values before it writes a query, and a hybrid of the two. The interesting part is the grounding, getting the exact categorical values, the right year and the right spatial level, rather than the SQL syntax itself.",
          short:
            'A course paper comparing three ways to turn plain-language questions into SQL over real Swiss federal statistics: a fixed grounding pipeline, a ReAct agent that probes the database, and a hybrid, built on LangChain and LangGraph.',
          href: 'https://drive.google.com/file/d/1sFv4ktlgIOtf23QgjB73a9o1WpDCtxHl/view',
          external: true,
          print: true,
        },
        {
          period: '2026',
          title: 'MNIST digit recognition by hand',
          detail:
            'A neural network for handwritten digits, written by hand in TypeScript with no machine-learning framework anywhere in it. I implemented the forward pass and back-propagation myself, a multilayer perceptron with ReLU hidden layers and a softmax over the ten digits. Trained on 50,000 images and tested on 9,000, it lands at about 95% accuracy. There is a small web version too, where you draw a digit on a canvas and it gets centred by its centre of mass before the network sees it.',
          short:
            'A neural network for handwritten digits, written by hand in TypeScript with no machine-learning framework. I wrote the forward pass and back-propagation myself; trained on 50,000 images, it reaches about 95% accuracy on MNIST.',
          href: 'https://digits.aneshodza.ch',
          external: true,
          print: false,
        },
        {
          period: '2025',
          title: 'Query Errors & Cognitive Variance',
          detail:
            "A short paper on how input errors break search and how cheaply that can be fixed. I simulated three kinds of error grounded in medical research, the typos of a healthy typist, the tremor-driven slips of Parkinson's, and the letter confusions of dyslexia, and measured BM25 retrieval with and without a correction step that maps each word to its nearest match by Levenshtein distance.",
          short:
            "A short paper on how typos, Parkinson's and dyslexia degrade BM25 search, and how a Levenshtein correction step recovers it.",
          href: 'https://drive.google.com/file/d/1Azp9R1ufht2OSDB7ahYeeu1ro6APo-dL/view',
          external: true,
          print: true,
        },
        {
          period: '2025',
          title: 'Numerical methods (HM2)',
          detail:
            "About twenty numerical methods I implemented in Python while studying for Higher Mathematics 2 at ZHAW, kept as small runnable scripts rather than notes. It covers a good stretch of the course: Newton's method with its damped and simplified variants, cubic splines, Lagrange interpolation and least-squares fits, Romberg integration, Runge-Kutta and Adams-Bashforth for differential equations, and a few applied problems like a pendulum and a rocket trajectory. It is one of the harder courses at the school, and working the methods out like this is what earned me a 6.0.",
          short:
            'Around twenty numerical methods from scratch in Python (splines, Runge-Kutta, Romberg, and more), which earned a perfect 6.0 in a ZHAW maths course.',
          href: 'https://github.com/aneshodza/hm2-scripts',
          external: true,
          print: true,
        },
      ];

research.sort((a, b) => Number(b.period) - Number(a.period));

const skills = [
  {
    key: 'skills.languages' as const,
    items: ['TypeScript', 'C#', 'Ruby', 'Rust', 'C', 'Python', 'SQL'],
  },
  {
    key: 'skills.frameworks' as const,
    items: ['Angular', 'NestJS', 'ASP.NET', 'Ruby on Rails', 'Astro', 'LangGraph.js'],
  },
  {
    key: 'skills.data' as const,
    items: ['PostgreSQL', 'MySQL', 'Qdrant', 'Drizzle'],
  },
  {
    key: 'skills.infrastructure' as const,
    items: ['Docker', 'CI/CD', 'Bun', 'Turborepo'],
  },
  {
    key: 'skills.concepts' as const,
    items:
      locale === 'de'
        ? ['MCP', 'RAG', 'Agentische Systeme', 'NLP', 'IR', 'Secure Development', 'Scrum', 'TDD']
        : ['MCP', 'RAG', 'Agentic systems', 'NLP', 'IR', 'Secure development', 'Scrum', 'TDD'],
  },
];

const languages =
  locale === 'de'
    ? [
        { label: 'Deutsch', level: 'C2' as const, note: 'Muttersprache' },
        { label: 'Bosnisch', level: 'C2' as const, note: 'Muttersprache' },
        { label: 'Englisch', level: 'C2' as const },
        { label: 'Französisch', level: 'B2' as const },
      ]
    : [
        { label: 'German', level: 'C2' as const, note: 'Native' },
        { label: 'Bosnian', level: 'C2' as const, note: 'Native' },
        { label: 'English', level: 'C2' as const },
        { label: 'French', level: 'B2' as const },
      ];

const cefr = ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'] as const;

const printFilename = locale === 'de' ? 'Lebenslauf_Anes_Hodza' : 'CV_Anes_Hodza';

const contact = [
  { label: locale === 'de' ? 'Ort' : 'Location', value: t('meta.location') },
  { label: t('contact.email'), value: t('meta.email') },
  { label: 'GitHub', value: 'github.com/aneshodza' },
  { label: 'LinkedIn', value: 'linkedin.com/in/aneshodza' },
];
---

<div class="cv-screen">
  <section class="mx-auto max-w-[68rem] px-5 md:px-10 pt-12 md:pt-20 pb-10">
    <div class="flex items-baseline justify-between border-b border-[var(--rule)] pb-3 mb-10">
      <p class="label">{t('nav.cv')}</p>
      <a
        href={`/${printFilename}.pdf`}
        download={`${printFilename}.pdf`}
        class="no-print font-sans text-[0.72rem] uppercase tracking-[0.14em] text-[var(--fg-subtle)] hover:text-[var(--accent)] inline-flex items-center min-h-[44px] md:min-h-0 px-1"
      >
        {t('cv.print')}
      </a>
    </div>

    <h1 class="display text-[2.5rem] md:text-[3.25rem] max-w-[42rem]">
      Anes Hodza.
    </h1>
    <p class="mt-3 font-serif italic text-[1.15rem] text-[var(--fg-muted)] max-w-[40rem]">
      {t('hero.tagline')}.
    </p>

    <dl class="mt-10 grid grid-cols-2 md:grid-cols-4 gap-6 border-t border-[var(--rule)] pt-6">
      <div>
        <dt class="label mb-1">{locale === 'de' ? 'Ort' : 'Location'}</dt>
        <dd class="font-serif text-[0.98rem]">{t('meta.location')}</dd>
      </div>
      <div>
        <dt class="label mb-1">{t('contact.email')}</dt>
        <dd class="font-serif text-[0.98rem] break-all">
          <a href={`mailto:${t('meta.email')}`} class="link-inline">{t('meta.email')}</a>
        </dd>
      </div>
      <div>
        <dt class="label mb-1">GitHub</dt>
        <dd class="font-serif text-[0.98rem]">
          <a
            href="https://github.com/aneshodza"
            class="link-inline"
            target="_blank"
            rel="noopener noreferrer me"
          >
            github.com/aneshodza
          </a>
        </dd>
      </div>
      <div>
        <dt class="label mb-1">LinkedIn</dt>
        <dd class="font-serif text-[0.98rem]">
          <a
            href="https://www.linkedin.com/in/aneshodza/"
            class="link-inline"
            target="_blank"
            rel="noopener noreferrer me"
          >
            linkedin.com/in/aneshodza
          </a>
        </dd>
      </div>
    </dl>
  </section>

  <section class="mx-auto max-w-[68rem] px-5 md:px-10 py-12">
    <h2 class="font-serif text-[1.5rem] md:text-[1.75rem] font-semibold tracking-tight border-b border-[var(--rule)] pb-2 mb-2">
      {t('sections.experience')}
    </h2>
    <div>
      {experience.map((entry) => <ExperienceItem entry={entry} />)}
    </div>
  </section>

  <section class="mx-auto max-w-[68rem] px-5 md:px-10 py-12">
    <h2 class="font-serif text-[1.5rem] md:text-[1.75rem] font-semibold tracking-tight border-b border-[var(--rule)] pb-2 mb-2">
      {t('sections.research')}
    </h2>
    <ul>
      {
        research.map((item) => (
          <li class="grid grid-cols-1 md:grid-cols-[14rem_1fr] gap-1 md:gap-10 py-6 border-t border-[var(--rule)] first:border-t-0">
            <p class="font-sans text-[0.72rem] uppercase tracking-[0.14em] text-[var(--fg-subtle)] md:pt-1">
              {item.period}
            </p>
            <div>
              <h3 class="font-serif text-[1.2rem] md:text-[1.25rem] font-semibold tracking-tight">
                <a
                  href={item.href}
                  class="link-inline"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {item.title}
                </a>
              </h3>
              <p class="font-serif text-[0.98rem] text-[var(--fg-muted)] mt-1 leading-relaxed">
                {item.detail}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-[68rem] px-5 md:px-10 py-12">
    <h2 class="font-serif text-[1.5rem] md:text-[1.75rem] font-semibold tracking-tight border-b border-[var(--rule)] pb-2 mb-2">
      {t('sections.education')}
    </h2>
    <div>
      {
        educationRendered.map(({ entry, Content }) => (
          <article class="grid grid-cols-1 md:grid-cols-[14rem_1fr] gap-3 md:gap-10 py-8 border-t border-[var(--rule)] first:border-t-0 first:pt-0">
            <header>
              <p class="font-sans text-[0.72rem] uppercase tracking-[0.14em] text-[var(--fg-subtle)]">
                {entry.data.period}
              </p>
              {entry.data.grade && (
                <p class="font-serif text-[0.92rem] italic text-[var(--fg-muted)] mt-1">
                  {entry.data.grade}
                </p>
              )}
            </header>
            <div>
              <h3 class="font-serif text-[1.2rem] md:text-[1.25rem] font-semibold tracking-tight">
                {entry.data.qualification}
                <span class="text-[var(--fg-subtle)] font-normal"> &middot; </span>
                <span class="font-normal italic">{entry.data.institution}</span>
              </h3>
              <div class="prose-editorial mt-3 max-w-none">
                <Content />
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-[68rem] px-5 md:px-10 py-12">
    <h2 class="font-serif text-[1.5rem] md:text-[1.75rem] font-semibold tracking-tight border-b border-[var(--rule)] pb-2 mb-2">
      {t('sections.achievements')}
    </h2>
    <ul>
      {
        achievements.map((item) => (
          <li class="grid grid-cols-1 md:grid-cols-[14rem_1fr] gap-1 md:gap-10 py-6 border-t border-[var(--rule)] first:border-t-0">
            <p class="font-sans text-[0.72rem] uppercase tracking-[0.14em] text-[var(--fg-subtle)] md:pt-1">
              {item.period}
            </p>
            <div>
              <h3 class="font-serif text-[1.2rem] md:text-[1.25rem] font-semibold tracking-tight">
                <a
                  href={item.href}
                  class="link-inline"
                  {...(item.external
                    ? { target: '_blank', rel: 'noopener noreferrer' }
                    : { target: '_blank', rel: 'noopener' })}
                >
                  {item.title}
                </a>
              </h3>
              <p class="font-serif italic text-[0.98rem] text-[var(--fg-muted)] mt-1">
                {item.detail}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-[68rem] px-5 md:px-10 py-12">
    <h2 class="font-serif text-[1.5rem] md:text-[1.75rem] font-semibold tracking-tight border-b border-[var(--rule)] pb-2 mb-6">
      {t('sections.skills')}
    </h2>
    <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-6">
      {
        skills.map((group) => (
          <div class="grid grid-cols-1 sm:grid-cols-[10rem_1fr] gap-1 sm:gap-6 border-t border-[var(--rule)] pt-4">
            <dt class="label sm:pt-0.5">{t(group.key)}</dt>
            <dd class="font-serif text-[0.98rem] leading-relaxed">
              {group.items.join(' · ')}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="mx-auto max-w-[68rem] px-5 md:px-10 py-12 pb-20">
    <h2 class="font-serif text-[1.5rem] md:text-[1.75rem] font-semibold tracking-tight border-b border-[var(--rule)] pb-2 mb-6">
      {t('languages.spoken')}
    </h2>
    <div class="max-w-[34rem] border-t border-[var(--rule)]">
      {languages.map((lang) => (
        <LanguageBar label={lang.label} level={lang.level} note={lang.note} />
      ))}
    </div>
  </section>
</div>

<!-- Print-only document: dedicated single-page A4 CV. Hidden on screen. -->
<div class="cv-doc" aria-hidden="true">
  <aside class="cv-doc__side">
    <figure class="cv-doc__portrait">
      <img src="/portrait.jpg" alt="" width="400" height="500" />
    </figure>

    <section class="cv-doc__block">
      <h2 class="cv-doc__label">{t('nav.contact')}</h2>
      <ul class="cv-doc__contact">
        {contact.map((c) => (
          <li>
            <span class="cv-doc__contact-key">{c.label}</span>
            <span class="cv-doc__contact-val">{c.value}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="cv-doc__block">
      <h2 class="cv-doc__label">{t('languages.spoken')}</h2>
      <ul class="cv-doc__langs">
        {languages.map((lang) => {
          const filled = cefr.indexOf(lang.level) + 1;
          return (
            <li>
              <div class="cv-doc__lang-top">
                <span>{lang.label}</span>
                <span class="cv-doc__lang-level">{lang.level}</span>
              </div>
              <div class="cv-doc__bar">
                {cefr.map((_, i) => (
                  <span class={i < filled ? 'on' : ''} />
                ))}
              </div>
            </li>
          );
        })}
      </ul>
    </section>

    <section class="cv-doc__block">
      <h2 class="cv-doc__label">{t('sections.skills')}</h2>
      <dl class="cv-doc__skills">
        {skills.map((group) => (
          <div>
            <dt>{t(group.key)}</dt>
            <dd>{group.items.join(', ')}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="cv-doc__block">
      <h2 class="cv-doc__label">{t('sections.achievements')}</h2>
      <ul class="cv-doc__awards">
        {achievements.map((item) => (
          <li>
            <span class="cv-doc__award-title">{item.title}</span>
            <span class="cv-doc__award-year">{item.period}</span>
          </li>
        ))}
      </ul>
    </section>
  </aside>

  <main class="cv-doc__main">
    <header class="cv-doc__head">
      <h1>Anes Hodza</h1>
      <p class="cv-doc__tagline">{t('hero.tagline')}.</p>
    </header>

    <section class="cv-doc__section">
      <h2 class="cv-doc__heading">{t('sections.experience')}</h2>
      {experienceRendered.map(({ entry, Content }) => (
        <article class="cv-doc__entry">
          <div class="cv-doc__entry-meta">
            <p class="cv-doc__period">{entry.data.period}</p>
            <p class="cv-doc__loc">{entry.data.location}</p>
          </div>
          <div class="cv-doc__entry-body">
            <h3>
              {entry.data.role}
              <span class="cv-doc__sep"> · </span>
              <em>{entry.data.company}</em>
            </h3>
            <div class="cv-doc__desc">
              <Content />
            </div>
            {entry.data.tech.length > 0 && (
              <p class="cv-doc__tech">{entry.data.tech.join(' · ')}</p>
            )}
          </div>
        </article>
      ))}
    </section>

    <section class="cv-doc__section">
      <h2 class="cv-doc__heading">{t('sections.research')}</h2>
      <ul class="cv-doc__projects">
        {research.filter((item) => item.print).map((item) => (
          <li>
            <span class="cv-doc__proj-title">{item.title}</span>
            <span class="cv-doc__proj-year">{item.period}</span>
            <span class="cv-doc__proj-desc">{item.short}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="cv-doc__section">
      <h2 class="cv-doc__heading">{t('sections.education')}</h2>
      {educationRendered.map(({ entry }) => (
        <article class="cv-doc__entry">
          <div class="cv-doc__entry-meta">
            <p class="cv-doc__period">{entry.data.period}</p>
            {entry.data.grade && <p class="cv-doc__loc">{entry.data.grade}</p>}
          </div>
          <div class="cv-doc__entry-body">
            <h3>
              {entry.data.qualification}
              <span class="cv-doc__sep"> · </span>
              <em>{entry.data.institution}</em>
            </h3>
          </div>
        </article>
      ))}
    </section>

  </main>
</div>

<style>
