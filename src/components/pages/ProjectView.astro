---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { getLocaleFromUrl, useTranslations, localizePath } from '~/i18n/utils';

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const back = localizePath('/projects', locale);

const isExternal = (url: string) => /^https?:\/\//.test(url);
---

<article>
  <header class="top frame">
    <div class="top-bar">
      <p class="kicker instrument">{t('nav.projects')}</p>
      <a class="back link-nav" href={back}>{t('project.back')}</a>
    </div>

    <h1 class="top-title display">{entry.data.title}.</h1>
    <p class="top-summary">{entry.data.summary}</p>
  </header>

  {/* The instrument panel for this layer. */}
  <section class="panel frame">
    <dl class="panel-grid">
      <div class="cell">
        <dt class="instrument">{t('project.role')}</dt>
        <dd>{entry.data.role}</dd>
      </div>
      <div class="cell">
        <dt class="instrument">{t('project.status')}</dt>
        <dd>{entry.data.statusLabel}</dd>
      </div>
      <div class="cell">
        <dt class="instrument">{t('project.year')}</dt>
        <dd class="num">{entry.data.year}</dd>
      </div>
      <div class="cell">
        <dt class="instrument">{t('project.links')}</dt>
        <dd>
          <ul class="links">
            {
              entry.data.links.map((l) => (
                <li>
                  <a
                    class="link"
                    href={l.url}
                    {...(isExternal(l.url)
                      ? { target: '_blank', rel: 'noopener noreferrer' }
                      : {})}
                  >
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </dd>
      </div>
    </dl>
  </section>

  <section class="read frame">
    <div class="prose">
      <Content />
    </div>

    <aside class="aside">
      <p class="instrument aside-head">{t('project.tech')}</p>
      <ul class="stack">
        {entry.data.tech.map((tech) => <li>{tech}</li>)}
      </ul>
    </aside>
  </section>

  <nav class="tail frame" aria-label={t('nav.projects')}>
    <hr class="hairline" />
    <div class="tail-row">
      <a class="back back-lg link-nav" href={back}>{t('project.back')}</a>
      <a class="action" href={localizePath('/contact', locale)}>{t('hero.cta.contact')}</a>
    </div>
  </nav>
</article>

<style>
  .top {
    padding-block: max(clamp(6.5rem, 15vh, 10rem), var(--hud-clear)) clamp(1.5rem, 4vh, 2.5rem);
    display: grid;
    gap: clamp(1rem, 2.5vh, 1.75rem);
  }

  .top-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }

  .kicker {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .kicker::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }

  /* A drawn chevron, so the affordance is a shape rather than a character
     pasted onto the label. */
  .back {
    --rule-y: 12px;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    font-family: var(--font-sans);
    font-size: var(--t--1);
    font-weight: 500;
    color: var(--ink-3);
  }

  .back::before {
    content: '';
    width: 0.44rem;
    height: 0.44rem;
    border-left: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
    transition: transform 0.55s var(--spring-snap);
  }

  .back:hover::before,
  .back:focus-visible::before {
    transform: rotate(45deg) translate(-2px, 2px);
  }

  .back-lg {
    font-size: var(--t--1);
    color: var(--ink-2);
  }

  .top-title {
    margin: 0;
    font-size: var(--t-5);
  }

  .top-summary {
    margin: 0;
    font-size: var(--t-1);
    line-height: 1.5;
    font-style: italic;
    color: var(--ink-2);
    max-width: 48ch;
  }

  .panel {
    padding-block: clamp(1.5rem, 4vh, 2.5rem);
  }

  .panel-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    padding: 1px;
    border-radius: 14px;
    border: 1px solid var(--edge-soft);
    background: var(--edge-soft);
    overflow: hidden;
  }

  .cell {
    display: grid;
    gap: 0.4rem;
    align-content: start;
    padding: 1rem 1.1rem 1.15rem;
    background: color-mix(in srgb, var(--field) 88%, transparent);
  }

  .cell dt {
    margin: 0;
  }

  .cell dd {
    margin: 0;
    font-size: var(--t--1);
    line-height: 1.45;
    color: var(--ink);
  }

  .cell dd.num {
    font-family: var(--font-sans);
    font-variant-numeric: tabular-nums lining-nums;
    font-weight: 500;
  }

  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }

  .links a {
    word-break: break-word;
  }

  .read {
    padding-block: clamp(2rem, 6vh, 4rem);
    display: grid;
    gap: clamp(2.5rem, 6vh, 4rem);
  }

  .aside-head {
    margin: 0 0 0.75rem;
    padding-block-end: 0.6rem;
    border-bottom: 1px solid var(--edge);
  }

  .stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
  }

  .stack li {
    position: relative;
    padding-inline-start: 0.9rem;
    padding-block: 0.28rem;
    font-family: var(--font-sans);
    font-size: var(--t--2);
    font-weight: 450;
    color: var(--ink-3);
  }

  .stack li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: calc(50% - var(--hairline) / 2);
    width: 0.45rem;
    height: var(--hairline);
    background: var(--accent);
    opacity: 0.65;
  }

  .tail {
    padding-block: clamp(2rem, 5vh, 3rem) 0;
  }

  .tail-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block-start: 1rem;
  }

  @media (min-width: 48rem) {
    .panel-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .read {
      grid-template-columns: minmax(0, 1fr) 17rem;
      gap: clamp(3rem, 7vw, 6rem);
      align-items: start;
    }

    .aside {
      position: sticky;
      top: 6rem;
    }

    .stack {
      flex-direction: column;
      gap: 0;
    }
  }
</style>
