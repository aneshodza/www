---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { getLocaleFromUrl, useTranslations, localizePath } from '~/i18n/utils';

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const back = localizePath('/projects', locale);

const isExternal = (url: string) => /^https?:\/\//.test(url);
---

<article>
  <header class="top page-head frame">
    <div class="top-bar">
      <p class="kicker">{t('nav.projects')}</p>
      <a class="back link-nav" href={back}>{t('project.back')}</a>
    </div>

    <h1 class="top-title display">{entry.data.title}.</h1>
    <p class="top-summary">{entry.data.summary}</p>
  </header>

  {/* The instrument panel for this layer. */}
  <section class="panel frame">
    <dl class="panel-grid">
      <div class="cell">
        <dt class="instrument">{t('project.role')}</dt>
        <dd>{entry.data.role}</dd>
      </div>
      <div class="cell">
        <dt class="instrument">{t('project.status')}</dt>
        <dd>{entry.data.statusLabel}</dd>
      </div>
      <div class="cell">
        <dt class="instrument">{t('project.year')}</dt>
        <dd class="readout">{entry.data.year}</dd>
      </div>
      <div class="cell">
        <dt class="instrument">{t('project.links')}</dt>
        <dd>
          <ul class="links">
            {
              entry.data.links.map((l) => (
                <li>
                  <a
                    class="link"
                    href={l.url}
                    {...(isExternal(l.url)
                      ? { target: '_blank', rel: 'noopener noreferrer' }
                      : {})}
                  >
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </dd>
      </div>
    </dl>
  </section>

  <section class="read frame">
    <div class="prose">
      <Content />
    </div>

    <aside class="aside">
      <p class="instrument aside-head">{t('project.tech')}</p>
      <ul class="stack rule-list">
        {entry.data.tech.map((tech) => <li>{tech}</li>)}
      </ul>
    </aside>
  </section>

  <nav class="tail frame" aria-label={t('nav.projects')}>
    <hr class="hairline" />
    <div class="tail-row">
      <a class="back is-strong link-nav" href={back}>{t('project.back')}</a>
      <a class="action" href={localizePath('/contact', locale)}>{t('hero.cta.contact')}</a>
    </div>
  </nav>
</article>

<style>
  .top {
    --head-bottom: clamp(1.5rem, 4vh, 2.5rem);
  }

  .top-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }

  /* The tail copy of the back link carries more weight than the header one,
     since by then it is the primary way out. */
  .back.is-strong {
    color: var(--ink-2);
  }

  .top-title {
    font-size: var(--t-5);
  }

  .top-summary {
    font-size: var(--t-1);
    line-height: 1.5;
    font-style: italic;
    color: var(--ink-2);
    max-width: 48ch;
  }

  /* ---- Fact panel ------------------------------------------------------
     Role / status / year / links, as cells separated by their own gap over a
     tinted backing, so the dividers are the background showing through.
     ------------------------------------------------------------------- */

  .panel {
    padding-block: clamp(1.5rem, 4vh, 2.5rem);
  }

  .panel-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    padding: 1px;
    border-radius: 14px;
    border: 1px solid var(--edge-soft);
    background: var(--edge-soft);
    overflow: hidden;
  }

  .cell {
    display: grid;
    gap: 0.4rem;
    align-content: start;
    padding: 1rem 1.1rem 1.15rem;
    background: color-mix(in srgb, var(--field) 88%, transparent);
  }

  .cell dd {
    font-size: var(--t--1);
    line-height: 1.45;
    color: var(--ink);
  }

  .links {
    display: grid;
    gap: 0.35rem;
  }

  .links a {
    word-break: break-word;
  }

  /* ---- Reading ---------------------------------------------------------- */

  .read {
    padding-block: clamp(2rem, 6vh, 4rem);
    display: grid;
    gap: clamp(2.5rem, 6vh, 4rem);
  }

  .aside-head {
    margin-bottom: 0.75rem;
    padding-block-end: 0.6rem;
    border-bottom: 1px solid var(--edge);
  }

  .stack {
    gap: 0 1.25rem;
  }

  .tail {
    padding-block: clamp(2rem, 5vh, 3rem) 0;
  }

  .tail-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block-start: 1rem;
  }

  @media (min-width: 48rem) {
    .panel-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* Wide enough for the tech list to sit beside the copy and stay put. */
  @media (min-width: 64rem) {
    .read {
      grid-template-columns: minmax(0, 1fr) 17rem;
      gap: clamp(3rem, 7vw, 6rem);
      align-items: start;
    }

    .aside {
      position: sticky;
      top: 6rem;
    }

    .stack {
      flex-direction: column;
      gap: 0;
    }
  }
</style>
