---
import { getLocaleFromUrl, useTranslations, localizePath } from '~/i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<section class="void page-head frame">
  <p class="kicker">404</p>
  <h1 class="void-title display">{t('404.title')}.</h1>
  <p class="void-body lede">{t('404.body')}</p>
  <p class="void-go">
    <a class="action-solid" href={localizePath('/', locale)}>{t('404.home')}</a>
  </p>
</section>

<style>
  .void {
    --head-top: clamp(7rem, 16vh, 11rem);
    --head-bottom: clamp(3rem, 8vh, 5rem);
    --head-gap: clamp(1rem, 3vh, 1.85rem);
    min-height: 60svh;
    align-content: center;
  }

  .void-title {
    font-size: var(--t-4);
    max-width: 14ch;
  }

  .void-body {
    max-width: 46ch;
  }

  .void-go {
    margin-top: 0.5rem;
  }
</style>
