---
import { getCollection } from 'astro:content';
import Feature from '~/components/Feature.astro';
import { getLocaleFromUrl, useTranslations, localizePath } from '~/i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const projects = (
  await getCollection('projects', (e) => e.data.locale === locale)
).sort((a, b) => a.data.order - b.data.order);

const featured = projects[0];
const rest = projects.slice(1);
---

<section class="head page-head frame">
  <p class="kicker">{t('nav.projects')}</p>

  <h1 class="head-title display">
    {locale === 'de' ? 'Projekte und Veröffentlichungen.' : 'Projects and releases.'}
  </h1>

  <p class="lede">
    {locale === 'de'
      ? 'Eine Auswahl von Projekten, an welchen ich gearbeitet habe.'
      : 'A selection of projects I have worked on.'}
  </p>
</section>

{featured && <Feature entry={featured} eyebrow={t('sections.featured')} />}

{
  rest.length > 0 && (
    <section class="strata frame">
      <hr class="hairline" />
      <h2 class="strata-head instrument">
        {locale === 'de' ? 'Weitere Projekte' : 'More projects'}
      </h2>

      {/* A section drawing. The ordinals are the depth scale, and each project
          is pinned at the layer it was built at. */}
      <ol class="rail">
        {rest.map((entry, i) => {
          const href = localizePath(`/projects/${entry.data.slug}`, locale);
          return (
            <li class="layer">
              <a class="layer-link" href={href}>
                <span class="layer-index">{String(i + 2).padStart(2, '0')}</span>
                <span class="layer-body">
                  <span class="layer-title display-sm"><span class="layer-title-text link-nav">{entry.data.title}</span></span>
                  <span class="layer-summary">{entry.data.summary}</span>
                </span>
              </a>
            </li>
          );
        })}
      </ol>
    </section>
  )
}

<style>
  .head {
    --head-top: clamp(7rem, 16vh, 11rem);
    --head-bottom: clamp(2rem, 5vh, 3.5rem);
  }

  .head-title {
    font-size: var(--t-4);
    max-width: 16ch;
  }

  .strata {
    padding-block: clamp(2rem, 6vh, 4rem);
  }

  .strata-head {
    margin-top: 1.25rem;
  }

  /* ---- The rail --------------------------------------------------------
     A numbered list of everything past the featured project. The vertical
     rule behind it fades at both ends so it reads as a continuing spine
     rather than a bounded box.
     ------------------------------------------------------------------- */

  .rail {
    position: relative;
  }

  .rail::before {
    content: '';
    position: absolute;
    inset-block: 1.6rem;
    inset-inline-start: 0;
    width: 1px;
    background: linear-gradient(
      180deg,
      transparent,
      var(--edge) 8%,
      var(--edge) 92%,
      transparent
    );
  }

  .layer-link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 0 clamp(1rem, 3vw, 2.25rem);
    padding-block: clamp(1.25rem, 3vh, 2rem);
    border-bottom: 1px solid var(--edge-soft);
    transition: transform 0.75s var(--spring-soft);
  }

  .layer:last-child .layer-link {
    border-bottom: 0;
  }

  .layer-index {
    position: relative;
    padding-inline-start: 1.5rem;
    padding-block-start: 0.45em;
    font-family: var(--font-sans);
    font-size: var(--t--2);
    font-weight: 560;
    font-variant-numeric: tabular-nums lining-nums;
    color: var(--ink-3);
    transition: color 0.45s var(--ease-out);
  }

  /* A tick off the rail, drawn short and extending to full width on hover. */
  .layer-index::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.95em;
    width: 1.15rem;
    height: 1px;
    background: var(--edge);
    transform: scaleX(0.74);
    transform-origin: left;
    transition:
      background-color 0.45s var(--ease-out),
      transform 0.6s var(--spring-snap);
  }

  .layer-body {
    display: grid;
    gap: 0.4rem;
  }

  .layer-title {
    font-size: var(--t-2);
    line-height: 1.16;
    color: var(--ink);
  }

  /* The rule belongs to the text, not the heading box, so it is drawn on an
     inner span with room under the baseline for it. */
  .layer-title-text {
    --rule-y: 0.02em;
    padding-block-end: 0.18em;
    line-height: 1.4;
    color: inherit;
  }

  .layer-summary {
    font-size: var(--t-0);
    line-height: 1.6;
    color: var(--ink-3);
    max-width: 52ch;
  }

  /* The whole row is the target: it steps in, the tick extends, the title
     takes its rule and the accent. */
  @media (hover: hover) {
    .layer-link:hover,
    .layer-link:focus-visible {
      transform: translateX(0.5rem);
    }
  }

  .layer-link:hover .layer-title,
  .layer-link:focus-visible .layer-title,
  .layer-link:hover .layer-index,
  .layer-link:focus-visible .layer-index {
    color: var(--accent-text);
  }

  .layer-link:hover .layer-title-text,
  .layer-link:focus-visible .layer-title-text {
    background-size: 100% 1px;
  }

  .layer-link:hover .layer-index::before,
  .layer-link:focus-visible .layer-index::before {
    background: var(--accent);
    transform: scaleX(1);
  }

  .layer-link:focus-visible {
    outline-offset: 6px;
  }

  @media (min-width: 60rem) {
    .head-title {
      font-size: var(--t-5);
      max-width: none;
    }

    .layer-link {
      grid-template-columns: 5rem minmax(0, 1fr);
    }

    .layer-body {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: baseline;
      gap: 0 var(--gutter);
    }

    .layer-summary {
      padding-block-start: 0.35em;
    }
  }
</style>
