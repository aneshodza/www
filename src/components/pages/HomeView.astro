---
import { getCollection } from 'astro:content';
import Surface from '~/components/Surface.astro';
import Feature from '~/components/Feature.astro';
import { getLocaleFromUrl, useTranslations, localizePath } from '~/i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const projects = (
  await getCollection('projects', (e) => e.data.locale === locale)
).sort((a, b) => a.data.order - b.data.order);

const featured = projects[0];
const remaining = Math.max(projects.length - 1, 0);
---

<Surface />

{featured && <Feature entry={featured} eyebrow={t('sections.featured')} />}

{
  remaining > 0 && (
    <section class="outro frame">
      <hr class="hairline" />
      <div class="outro-row">
        <p class="outro-count">
          {locale === 'de' ? `${remaining} weitere Projekte` : `${remaining} more projects`}
        </p>
        <a class="action" href={localizePath('/projects', locale)}>
          {t('sections.projects.all')}
        </a>
      </div>
    </section>
  )
}

<style>
  .outro {
    padding-block: clamp(3rem, 9vh, 6rem) clamp(2rem, 6vh, 4rem);
  }

  .outro-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2.5rem;
    padding-block-start: clamp(1.5rem, 4vh, 2.5rem);
  }

  .outro-count {
    margin: 0;
    font-size: var(--t-2);
    font-weight: 380;
    letter-spacing: -0.02em;
    color: var(--ink-3);
    font-variant-numeric: lining-nums;
  }
</style>
