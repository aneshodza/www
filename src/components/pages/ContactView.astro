---
import { getLocaleFromUrl, useTranslations } from '~/i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

// Formbricks (self-hosted): public client API, called from the browser.
// All three must be set via PUBLIC_FORMBRICKS_* env vars (see .env.example).
// The survey needs four open-text questions whose "Question ID" (advanced
// settings) is set to: name, email, subject, message.
const formbricks = {
  appUrl: import.meta.env.PUBLIC_FORMBRICKS_APP_URL,
  environmentId: import.meta.env.PUBLIC_FORMBRICKS_ENVIRONMENT_ID,
  surveyId: import.meta.env.PUBLIC_FORMBRICKS_SURVEY_ID,
};

const channels = [
  {
    label: locale === 'de' ? 'E-Mail' : 'Email',
    value: t('meta.email'),
    href: `mailto:${t('meta.email')}`,
    external: false,
  },
  {
    label: 'GitHub',
    value: 'github.com/aneshodza',
    href: 'https://github.com/aneshodza',
    external: true,
  },
  {
    label: 'LinkedIn',
    value: 'linkedin.com/in/aneshodza',
    href: 'https://www.linkedin.com/in/aneshodza/',
    external: true,
  },
  {
    label: 'dev.to',
    value: 'dev.to/aneshodza',
    href: 'https://dev.to/aneshodza',
    external: true,
  },
  {
    label: 'npm',
    value: 'npmjs.com/~aneshodza',
    href: 'https://www.npmjs.com/~aneshodza',
    external: true,
  },
];
---
<section class="head frame">
  <p class="kicker instrument">{t('nav.contact')}</p>

  <h1 class="head-title display">
    {locale === 'de' ? 'Reden wir.' : 'Let us talk.'}
  </h1>

  <p class="head-lede lede">{t('contact.intro')}</p>
</section>

<div class="body frame">
  <form
    id="contact-form"
    class="form"
    data-app-url={formbricks.appUrl}
    data-environment-id={formbricks.environmentId}
    data-survey-id={formbricks.surveyId}
    data-error-required={t('contact.form.error.required')}
    data-error-email={t('contact.form.error.email')}
    data-error-submit={t('contact.form.error.submit')}
    data-sending={t('contact.form.sending')}
    data-success={t('contact.form.success')}
    novalidate
  >
    <div class="pair">
      <p class="field">
        <label class="instrument" for="cf-name">{t('contact.form.name')}</label>
        <span class="control"><input id="cf-name" name="name" type="text" class="input" aria-describedby="cf-name-error" /></span>
        <span id="cf-name-error" class="err" aria-live="polite"></span>
      </p>
      <p class="field">
        <label class="instrument" for="cf-email">{t('contact.form.email')}</label>
        <span class="control"><input id="cf-email" name="email" type="email" class="input" aria-describedby="cf-email-error" /></span>
        <span id="cf-email-error" class="err" aria-live="polite"></span>
      </p>
    </div>

    <p class="field">
      <label class="instrument" for="cf-title">{t('contact.form.title')}</label>
      <span class="control"><input id="cf-title" name="title" type="text" class="input" aria-describedby="cf-title-error" /></span>
      <span id="cf-title-error" class="err" aria-live="polite"></span>
    </p>

    <p class="field">
      <label class="instrument" for="cf-body">{t('contact.form.message')}</label>
      <span class="control"><textarea id="cf-body" name="body" rows="5" class="input area" aria-describedby="cf-body-error"></textarea></span>
      <span id="cf-body-error" class="err" aria-live="polite"></span>
    </p>

    <div class="submit">
      <button type="submit" id="cf-submit" class="action-solid" data-label={t('contact.form.send')}>
        {t('contact.form.send')}
      </button>
      <p id="cf-status" class="status" role="status" aria-live="polite"></p>
    </div>
  </form>

  <aside class="channels">
    <dl class="channel-list">
      {
        channels.map((c) => (
          <div class="channel">
            <dt class="instrument">{c.label}</dt>
            <dd>
              <a
                class="link channel-val"
                href={c.href}
                {...(c.external
                  ? { target: '_blank', rel: 'noopener noreferrer me' }
                  : {})}
              >
                {c.value}
              </a>
            </dd>
          </div>
        ))
      }
    </dl>
  </aside>
</div>

<style>
  .head {
    padding-block: max(clamp(6.5rem, 15vh, 10rem), var(--hud-clear)) clamp(1.5rem, 4vh, 2.5rem);
    display: grid;
    gap: clamp(1rem, 2.5vh, 1.75rem);
  }

  .kicker {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .kicker::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }

  .head-title {
    margin: 0;
    font-size: var(--t-5);
  }

  .head-lede {
    margin: 0;
    max-width: 52ch;
  }

  .body {
    display: grid;
    gap: clamp(3rem, 8vh, 5rem);
    padding-block: clamp(2rem, 6vh, 3.5rem) clamp(2rem, 6vh, 4rem);
  }

  .form {
    display: grid;
    gap: clamp(1.35rem, 3vh, 1.9rem);
  }

  .pair {
    display: grid;
    gap: clamp(1.35rem, 3vh, 1.9rem);
  }

  .field {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    position: relative;
  }

  .field label {
    transition: color 0.4s var(--ease-out);
  }

  .field:focus-within label {
    color: var(--accent-text);
  }

  /* The rule under a field is the instrument: it fills from the leading edge
     on focus, on the same spring as every other control on the site. */
  /* A real container, not a floating rule: over a lit field an invisible
     input reads as unfinished. */
  .input {
    display: block;
    width: 100%;
    background: color-mix(in srgb, var(--shelf) 62%, transparent);
    border: 1px solid var(--edge);
    border-bottom: 1px solid var(--ink-3);
    border-radius: 8px 8px 2px 2px;
    padding: 0.6rem 0.75rem 0.65rem;
    font-family: var(--font-serif);
    font-size: var(--t-0);
    line-height: 1.6;
    color: var(--ink);
    border-radius: 0;
  }

  .input:hover {
    border-bottom-color: var(--ink-2);
    background: color-mix(in srgb, var(--shelf) 78%, transparent);
  }

  .input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .control {
    position: relative;
    display: block;
  }

  .control::after {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    bottom: 0;
    height: 2px;
    border-radius: 0 0 2px 2px;
    width: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--spring-snap);
    pointer-events: none;
  }

  .control:focus-within::after {
    transform: scaleX(1);
  }

  .area {
    resize: vertical;
    min-height: 9rem;
  }

  /* Alarm, not accent: on this page --accent is the same amber as the kicker
     dot, the list ticks and the field behind the form. */
  .err {
    font-family: var(--font-sans);
    font-size: var(--t--2);
    font-weight: 500;
    line-height: 1.4;
    color: var(--alarm);
  }

  .err:empty {
    display: none;
  }

  /* Two channels, and both persist: colour plus a heavier rule, so an invalid
     field still reads as invalid once focus moves on. */
  .input[aria-invalid='true'] {
    border-color: var(--alarm);
    border-bottom-width: 2px;
    padding-bottom: calc(0.65rem - 1px);
  }

  .submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }

  .status {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--t--1);
    line-height: 1.45;
    color: var(--ink-2);
  }

  .status[data-state='error'] {
    color: var(--alarm);
  }

  .status:empty {
    display: none;
  }

  /* Replaces the whole form once the message is away; created in script, so
     it is styled globally. */
  :global(.contact-sent) {
    margin: 0;
    font-size: var(--t-1);
    line-height: 1.5;
    color: var(--ink);
    max-width: 44ch;
  }

  .channel-list {
    display: grid;
    gap: 0;
    margin: 0;
    border-top: 1px solid var(--edge);
  }

  .channel {
    display: grid;
    gap: 0.3rem;
    padding-block: 0.4rem 0.55rem;
    border-bottom: 1px solid var(--edge-soft);
  }

  .channel dt,
  .channel dd {
    margin: 0;
  }

  /* The rule belongs under the text; hanging it off the bottom of a 44px
     inline-flex box is what made these look mismatched. */
  .channel-val {
    --rule-y: 13px;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--t--1);
    font-family: var(--font-sans);
    font-weight: 450;
    word-break: break-word;
  }

  @media (min-width: 40rem) {
    .pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(1.5rem, 4vw, 2.5rem);
    }
  }

  @media (min-width: 64rem) {
    .head-title { font-size: var(--t-display); }

    .body {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: clamp(3rem, 8vw, 7rem);
      align-items: start;
    }

    .channels {
      position: sticky;
      top: 6rem;
    }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  if (form) {
    const requiredMsg = form.dataset.errorRequired ?? '';
    const emailMsg = form.dataset.errorEmail ?? '';

    const fields = ['name', 'email', 'title', 'body'] as const;
    const inputs = Object.fromEntries(
      fields.map((name) => [
        name,
        form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement,
      ]),
    ) as Record<(typeof fields)[number], HTMLInputElement | HTMLTextAreaElement>;

    const errorFor = (name: string) =>
      document.getElementById(`cf-${name}-error`) as HTMLElement | null;

    const setError = (
      el: HTMLInputElement | HTMLTextAreaElement,
      message: string,
    ) => {
      const slot = errorFor(el.name);
      if (slot) slot.textContent = message;
      if (message) el.setAttribute('aria-invalid', 'true');
      else el.removeAttribute('aria-invalid');
    };

    const validateField = (name: (typeof fields)[number]): boolean => {
      const el = inputs[name];
      const value = el.value.trim();

      if (!value) {
        setError(el, requiredMsg);
        return false;
      }
      if (name === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
        setError(el, emailMsg);
        return false;
      }
      setError(el, '');
      return true;
    };

    // Clear an error as soon as the user fixes the field.
    fields.forEach((name) => {
      inputs[name].addEventListener('input', () => {
        if (inputs[name].getAttribute('aria-invalid') === 'true') {
          validateField(name);
        }
      });
    });

    const submitBtn = document.getElementById('cf-submit') as HTMLButtonElement;
    const status = document.getElementById('cf-status') as HTMLElement;
    const sendLabel = submitBtn.dataset.label ?? submitBtn.textContent ?? '';

    const setStatus = (message: string, state: 'info' | 'error') => {
      status.textContent = message;
      status.dataset.state = state;
    };

    const submitToFormbricks = async (): Promise<void> => {
      const { appUrl, environmentId, surveyId } = form.dataset;

      const res = await fetch(
        `${appUrl}/api/v1/client/${environmentId}/responses`,
        {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            surveyId,
            finished: true,
            data: {
              name: inputs.name.value.trim(),
              email: inputs.email.value.trim(),
              subject: inputs.title.value.trim(),
              message: inputs.body.value.trim(),
            },
            meta: { source: 'portfolio-contact-form', url: window.location.href },
          }),
        },
      );

      if (!res.ok) throw new Error(`Formbricks responded with ${res.status}`);
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      let firstInvalid: HTMLElement | null = null;
      for (const name of fields) {
        if (!validateField(name) && !firstInvalid) {
          firstInvalid = inputs[name];
        }
      }

      if (firstInvalid) {
        firstInvalid.focus();
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = form.dataset.sending ?? sendLabel;
      setStatus('', 'info');

      try {
        await submitToFormbricks();
        // Success: replace the form with a confirmation message.
        const note = document.createElement('p');
        note.className = 'contact-sent';
        note.setAttribute('role', 'status');
        note.textContent = form.dataset.success ?? '';
        form.replaceWith(note);
      } catch (error) {
        console.error(error);
        submitBtn.disabled = false;
        submitBtn.textContent = sendLabel;
        setStatus(form.dataset.errorSubmit ?? '', 'error');
      }
    });
  }
</script>
