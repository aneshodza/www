---
interface Props {
  label: string;
  level: 'A1' | 'A2' | 'B1' | 'B2' | 'C1' | 'C2';
  note?: string;
}

const { label, level, note } = Astro.props;

const levels = ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'] as const;
const filled = levels.indexOf(level) + 1;
---

<div class="lang-row">
  <p class="lang-name">
    {label}
    {note && <span class="lang-note">{note}</span>}
  </p>

  <div class="lang-level">
    <span class="instrument">{level}</span>
    <div class="lang-meter" role="img" aria-label={`${label}: ${level}`}>
      {levels.map((_, i) => <span class:list={[{ 'is-on': i < filled }]} aria-hidden="true" />)}
    </div>
  </div>
</div>

<style>
  .lang-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0 1rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--edge);
  }

  .lang-row:last-child {
    border-bottom: 0;
  }

  .lang-name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    font-size: var(--t-0);
  }

  .lang-note {
    font-style: italic;
    font-size: 0.92em;
    color: var(--ink-3);
  }

  .lang-level {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  /* Six cells, filled to the CEFR level. Outlined rather than tinted so an
     unfilled cell still reads as part of the scale. */
  .lang-meter {
    display: flex;
    gap: 3px;
  }

  .lang-meter span {
    width: 14px;
    height: 10px;
    border: 1px solid var(--edge);
  }

  .lang-meter span.is-on {
    background: var(--accent);
    border-color: var(--accent);
  }
</style>
