---
import {
  getLocaleFromUrl,
  otherLocale,
  switchLocalePath,
  useTranslations,
} from '~/i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const target = otherLocale(locale);
const href = switchLocalePath(Astro.url.pathname, target);
const t = useTranslations(locale);
---

<nav class="lang" aria-label={t('lang.switch')}>
  <a class="chip chip-lang" href={href} hreflang={target}>
    {target === 'en' ? 'EN' : 'DE'}
  </a>
</nav>

<style>
  /* The switcher is a landmark for assistive tech only; the HUD lays the chip
     out directly. */
  .lang {
    display: contents;
  }
</style>
