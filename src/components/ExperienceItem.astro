---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

interface Props {
  entry: CollectionEntry<'experience'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<article class="cv-entry">
  <header>
    <p class="cv-entry-period">{entry.data.period}</p>
    <p class="cv-entry-aside">{entry.data.location}</p>
  </header>

  <div>
    <h3 class="cv-entry-title">
      {entry.data.role}
      <span class="cv-entry-sep"> &middot; </span>
      <em>{entry.data.company}</em>
    </h3>

    <div class="prose cv-entry-body">
      <Content />
    </div>

    {
      entry.data.tech.length > 0 && (
        <ul class="rule-list cv-entry-tech">
          {entry.data.tech.map((tech) => <li>{tech}</li>)}
        </ul>
      )
    }
  </div>
</article>
