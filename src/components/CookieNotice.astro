---
import { getLocaleFromUrl } from '~/i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const text =
  locale === 'de'
    ? 'Diese Seite verwendet keine Cookies.'
    : 'This page does not use cookies.';
const dismiss = locale === 'de' ? 'Schliessen' : 'Dismiss';
---

<div id="cookie-notice" class="notice no-print" hidden>
  <p class="notice-text">{text}</p>
  <button id="cookie-notice-dismiss" type="button" class="notice-close" aria-label={dismiss}>
    {dismiss}
  </button>
</div>

<style>
  .notice {
    position: fixed;
    z-index: 55;
    inset-block-end: 0;
    inset-inline: 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.45rem 0.75rem 0.45rem 1rem;
    border-top: 1px solid var(--edge);
    border-radius: 0;
    background: var(--veil);
  }

  .notice[hidden] {
    display: none;
  }

  .notice-text {
    flex: 1;
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--t--1);
    line-height: 1.4;
    color: var(--ink-2);
  }

  .notice-close {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.8rem;
    flex: none;
    border: 1px solid var(--edge);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: var(--t--2);
    font-weight: 560;
    color: var(--ink-2);
    white-space: nowrap;
    transition:
      color 0.4s var(--ease-out),
      border-color 0.4s var(--ease-out),
      transform 0.5s var(--spring-snap);
  }

  .notice-close:hover,
  .notice-close:focus-visible {
    color: var(--accent-text);
    border-color: var(--accent);
  }

  .notice-close:active {
    transform: scale(0.96);
  }

  @media (min-width: 48rem) {
    .notice {
      inset-inline: auto 1.5rem;
      inset-block-end: 1.5rem;
      max-width: 30rem;
      padding: 0.7rem 0.7rem 0.7rem 1.1rem;
      border: 1px solid var(--edge);
      border-radius: 14px;
      box-shadow: 0 20px 50px -28px rgb(0 0 0 / 0.6);
    }
  }
</style>

<script is:inline>
  (() => {
    const KEY = 'cookie-notice-dismissed';
    const init = () => {
      const el = document.getElementById('cookie-notice');
      if (!el) return;
      try {
        if (localStorage.getItem(KEY) === '1') {
          el.remove();
          return;
        }
      } catch {}
      el.hidden = false;
      const btn = document.getElementById('cookie-notice-dismiss');
      if (btn && btn.dataset.bound !== '1') {
        btn.dataset.bound = '1';
        btn.addEventListener('click', () => {
          try {
            localStorage.setItem(KEY, '1');
          } catch {}
          el.remove();
        });
      }
    };
    init();
    if (!window.__cookieNoticeBound) {
      window.__cookieNoticeBound = true;
      document.addEventListener('astro:page-load', init);
    }
  })();
</script>
