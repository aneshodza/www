---
import '~/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Hud from '~/components/Hud.astro';
import Footer from '~/components/Footer.astro';
import Field from '~/components/Field.astro';
import CookieNotice from '~/components/CookieNotice.astro';
import type { Depth } from '~/lib/depth';
import { pageDepth } from '~/lib/depth';
import {
  getLocaleFromUrl,
  useTranslations,
  switchLocalePath,
} from '~/i18n/utils';

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
  depth?: Depth;
  /** The CV is a document, not a scene: it opts out of the field. */
  bare?: boolean;
}

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const {
  title,
  description,
  ogType = 'website',
  depth = pageDepth.home,
  bare = false,
} = Astro.props;

const pageTitle = `${title ?? t('nav.home')} | Anes`;
const metaDescription = description ?? t('site.description');

const altLocale = locale === 'de' ? 'en' : 'de';
const altPath = switchLocalePath(Astro.url.pathname, altLocale);
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const altUrl = new URL(altPath, Astro.site ?? Astro.url.origin).toString();
const socialImage = new URL('/og.png', Astro.site ?? Astro.url.origin).toString();

const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const umamiSrc = import.meta.env.PUBLIC_UMAMI_SRC;
const umamiEnabled = Boolean(umamiWebsiteId && umamiSrc);

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Anes Hodza',
  url: 'https://aneshodza.ch',
  image: new URL('/portrait.jpg', Astro.site ?? Astro.url.origin).toString(),
  jobTitle: t('hero.tagline'),
  email: 'mailto:me@aneshodza.ch',
  sameAs: [
    'https://github.com/aneshodza',
    'https://www.linkedin.com/in/aneshodza/',
    'https://dev.to/aneshodza',
    'https://www.npmjs.com/~aneshodza',
  ],
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'CH',
  },
  alumniOf: {
    '@type': 'EducationalOrganization',
    name: 'ZHAW Zurich University of Applied Sciences',
  },
  worksFor: {
    '@type': 'Organization',
    name: 'Centro Labs',
    url: 'https://centrolabs.ch',
  },
};
---

<!doctype html>
<html lang={locale} style={`--depth:${depth.base}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#eef0f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#06070b" media="(prefers-color-scheme: dark)" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="author" content="Anes Hodza" />

    <link rel="preload" href="/fonts/serif.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/sans.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={altLocale} href={altUrl} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'de' ? 'de_CH' : 'en_GB'} />
    <meta property="og:site_name" content="Anes Hodza" />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={socialImage} />

    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

    {
      umamiEnabled && (
        <script defer src={umamiSrc} data-website-id={umamiWebsiteId} />
      )
    }

    <ClientRouter />

    <script is:inline>
      (() => {
        const apply = () => {
          const root = document.documentElement;
          try {
            const stored = localStorage.getItem('theme');
            const prefersDark =
              window.matchMedia &&
              window.matchMedia('(prefers-color-scheme: dark)').matches;
            root.classList.toggle('dark', stored ? stored === 'dark' : prefersDark);
          } catch {}
          try {
            // Decided before first paint: the notice reserves space at the
            // bottom of the page, and discovering that after paint moves
            // anything anchored down there.
            root.classList.toggle(
              'has-notice',
              localStorage.getItem('cookie-notice-dismissed') !== '1',
            );
          } catch {
            root.classList.add('has-notice');
          }
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
  </head>

  <body>
    <a href="#main" class="skip">Skip to content</a>

    {!bare && <Field depth={depth} />}

    <Hud />

    <main id="main" class="shell">
      <slot />
    </main>

    <Footer />
    <CookieNotice />
  </body>
</html>
